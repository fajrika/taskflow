# Database (PostgreSQL via docker-compose)
DATABASE_URL=postgres://taskflow:taskflow_secret@localhost:5434/taskflow

# Auth — generate: openssl rand -base64 32
AUTH_SECRET=

# Web Push (VAPID) — generate dengan web-push. PUBLIC harus sama dengan NEXT_PUBLIC_VAPID_PUBLIC_KEY
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@taskflow.local

# Build args (client-side)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3004

# Telegram (opsional, satu bot untuk semua user)
TELEGRAM_BOT_TOKEN=

# Scheduler pengingat harian
SCHEDULER_ENABLED=true

# Port host
APP_PORT=3004
